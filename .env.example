# Generate .env safely with npm run secrets. This template contains no usable secrets.
POSTGRES_USER=mytikas
POSTGRES_DB=mytikas
POSTGRES_PASSWORD=replace_with_generated_password
DATABASE_URL=postgres://mytikas:replace_with_generated_password@localhost:5432/mytikas
SESSION_SECRET=replace_with_at_least_32_random_characters
APP_ORIGIN=http://localhost:8080
PORT=8080
# Optional: official Discord staff webhook. Never put this in browser code.
DISCORD_WEBHOOK_URL=
