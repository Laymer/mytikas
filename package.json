{
  "name": "mytikas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker.ts",
    "admin": "node --env-file-if-exists=.env --import tsx src/admin-cli.ts",
    "secrets": "node scripts/secrets.mjs",
    "test": "node --import tsx tests/run.ts",
    "test:browser": "node --import tsx tests/browser.ts",
    "smoke:armory": "node --import tsx scripts/armory-smoke.ts",
    "test:demo": "node --import tsx tests/demo.ts",
    "test:helper": "node tests/helper.mjs",
    "test:demo:browser": "node --import tsx tests/demo-browser.ts"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.5",
    "@types/express-session": "^1.18.2",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "embedded-postgres": "18.6.0-beta.19",
    "@playwright/test": "^1.56.1"
  }
}
