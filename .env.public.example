# Generate .env.public with node scripts/public.mjs init; never reuse local/demo secrets.
POSTGRES_PASSWORD=
RUNTIME_DATABASE_PASSWORD=
SESSION_SECRET=
DISCORD_WEBHOOK_URL=
PUBLIC_UID=1000
PUBLIC_GID=1000

# Generate independently: openssl rand -hex 32. Keep with encrypted backups.
EMAIL_OUTBOX_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Optional immutable published candidate; empty retains local builds.
MYTIKAS_IMAGE=
